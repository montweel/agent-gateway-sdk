{
  "name": "agent-gateway-sdk",
  "version": "1.3.0",
  "description": "Mont Agent Gateway SDK. Use is governed by TERMS.md.",
  "main": "dist/gateway.js",
  "bin": {
    "agent-gateway-sdk": "dist/cli.js",
    "mont-gateway": "dist/cli.js"
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 tests/security-chaos.test.ts tests/v12-features.test.ts tests/v13-shop.test.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.tools.json",
    "build": "tsc",
    "build:all": "tsc && npm --prefix dashboard run build",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "proxy": "tsx src/cli.ts start",
    "demo:shopify": "tsx examples/shopify-refund-demo/server.ts",
    "leads": "tsx scripts/find-leads.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/montweel/agent-gateway-sdk.git"
  },
  "homepage": "https://montweel.com",
  "keywords": [
    "ai-agents",
    "gateway",
    "mcp",
    "access-control",
    "audit",
    "approval"
  ],
  "author": "Montweel <support@montweel.com> (https://montweel.com)",
  "license": "SEE LICENSE IN TERMS.md",
  "type": "commonjs",
  "files": [
    "dist",
    "dashboard/dist",
    "README.md",
    "TERMS.md",
    "!mont-state.json"
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
